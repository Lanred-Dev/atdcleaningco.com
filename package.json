{
    "name": "atdcleaningco.com",
    "private": true,
    "type": "module",
    "version": "1.0.0",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
    },
    "devDependencies": {
        "@better-svelte-email/components": "^2.3.0",
        "@better-svelte-email/server": "^2.3.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/d3-scale": "^4.0.9",
        "@types/node": "^24",
        "auth": "^1.7.14",
        "better-auth": "^1.6.24",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.2",
        "email-validator": "^2.0.4",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^17.6.0",
        "layerchart": "^2.8.1",
        "libphonenumber-js": "^1.13.15",
        "mapbox-gl": "^3.33.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "resend": "^6.34.1",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.3.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.2"
    }
}
